# ---- Public origin (must match the URL users open; WebAuthn requires HTTPS outside localhost)
APP_ORIGIN=http://localhost:3010
# Defaults to APP_ORIGIN's hostname. Passkeys are bound to this — don't change it once users have enrolled.
# WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Firmware Hub

# ---- CouchDB (your existing instance)
COUCHDB_URL=http://localhost:5984
# User the app connects as (needs read/write on COUCHDB_DB)
COUCHDB_USER=fw_app
COUCHDB_PASSWORD=change-me
# The single database the app stores everything in
COUCHDB_DB=adas_dist
# Optional: only used by `npm run couch:init` to create indexes/design docs, if the app
# user is not an admin of COUCHDB_DB. Never used by the running app.
COUCHDB_ADMIN_USER=
COUCHDB_ADMIN_PASSWORD=

# ---- OpenID Connect (supplier + admin sign-in)
AUTH_SECRET=generate-with-openssl-rand-base64-32
OIDC_ISSUER=https://idp.example.com/realms/firmware
OIDC_CLIENT_ID=firmware-hub
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Company SSO
# Callback URL to register at the IdP: ${APP_ORIGIN}/api/auth/callback/oidc
# Users whose claim contains this value are admins. Dotted paths work, e.g. realm_access.roles
# Comma-separate several accepted values. For Google (no groups claim) use
# OIDC_ADMIN_CLAIM=email and list admin emails; only verified emails match.
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_VALUE=firmware-admins
# OIDC_SCOPES="openid email profile groups"

# ---- Sensor user sessions (passkeys)
# At least 32 characters: openssl rand -base64 48
SENSOR_SESSION_SECRET=

# ---- Email (enrolment invites). If unset, links are printed to the server log.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Firmware Hub <no-reply@example.com>"

# ---- Uploads
MAX_UPLOAD_MB=500
